# FareWatch configuration. Copy this file to ".env" (same folder) and edit.
# .env is listed in .gitignore - never commit it. No real secrets belong here.

# --- General -------------------------------------------------------------
APP_TIMEZONE=Europe/Sarajevo
DEFAULT_CURRENCY=EUR
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Start with demo fixtures shown (can also be toggled in Settings)
DEMO_MODE=false

# --- Storage -------------------------------------------------------------
# Leave empty/commented to use backend/data/farewatch.db (SQLite).
# PostgreSQL later: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/farewatch
# DATABASE_URL=

# --- SerpApi Google Flights (optional) -----------------------------------
# Get a key at https://serpapi.com/ . Leave empty to run without it.
SERPAPI_API_KEY=
SERPAPI_HL=en
SERPAPI_GL=
SERPAPI_TIMEOUT_SECONDS=25
SERPAPI_MAX_RETRIES=2
# Your plan's monthly search allowance (FareWatch stops before reaching it)
SERPAPI_MONTHLY_QUOTA=250
SERPAPI_DEEP_SEARCH=false

# --- Scheduled collector -------------------------------------------------
# Must be explicitly enabled. Runs only while the backend is running.
COLLECTOR_ENABLED=false
# Local times (APP_TIMEZONE), comma separated
COLLECTOR_TIMES=08:00,20:00
MAX_QUERIES_PER_DAY=6
MIN_MINUTES_BETWEEN_CHECKS=120
COLLECTOR_INCLUDE_COMPARISONS=true
COMPARISON_WINDOW_START=2026-11-01
COMPARISON_WINDOW_END=2027-01-31

# --- Analysis heuristic --------------------------------------------------
MEDIAN_THRESHOLD_PCT=15
MIN_SAMPLES_FOR_STATUS=5
DROP_ALERT_PCT=10

# --- Optional email alerts -----------------------------------------------
# Only used when ALERT_EMAIL_ENABLED=true AND all SMTP fields are set.
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
